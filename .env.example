# Shopify storefront and checkout
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional custom checkout host served by Shopify, for example checkout.your-domain.com.
# If omitted, checkout links use SHOPIFY_STORE_DOMAIN.
SHOPIFY_CHECKOUT_DOMAIN=

# Shopify admin + webhook signature validation
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_WEBHOOK_BASE_URL=https://recambiospa.cl/api/shopify/webhooks
SHOPIFY_DEBUG=0

DEFONTANA_BASE_URL=https://api-v2.defontana.com
DEFONTANA_AUTH_URL=https://api-v2.defontana.com/api/Auth/Login
DEFONTANA_CLIENT=
DEFONTANA_COMPANY=
DEFONTANA_USER=
DEFONTANA_PASSWORD=
DEFONTANA_SELLER_CODE=
DEFONTANA_WAREHOUSE_CODE=
DEFONTANA_PRICE_LIST_CODE=
DEFONTANA_DOCUMENT_TYPE=

INTEGRATION_TIMEZONE=America/Santiago

# Resend — email transaccional
RESEND_API_KEY=

# Analytics / tracking
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase - server-side customer profiles and contact messages
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Customer account panel
SESSION_SECRET=
SHOPIFY_CUSTOMER_AUTH_MODE=storefront
SHOPIFY_CUSTOMER_SESSION_COOKIE=recambio_customer_session
SHOPIFY_CUSTOMER_METAFIELD_NAMESPACE=recambio
